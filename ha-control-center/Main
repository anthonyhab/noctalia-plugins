import QtQuick
import Quickshell
import Quickshell.Io
import qs.Commons
import qs.Services.UI

Item {
  id: root

  property var pluginApi: null

  // Connection settings
  readonly property string haUrl: pluginApi?.pluginSettings?.haUrl || ""
  readonly property string haToken: pluginApi?.pluginSettings?.haToken || ""
  readonly property int pollInterval: pluginApi?.pluginSettings?.pollInterval || 5000

  // Connection state
  property bool connected: false
  property bool connecting: false
  property string connectionError: ""

  // HTTP request tracking
  property int requestId: 0
  property bool stateFetchInFlight: false
  property int consecutiveFailures: 0
  readonly property int maxBackoffMs: 30000

  // Entity state storage - keyed by entity_id
  property var entityStates: ({})
  property var availableEntities: []
  property double lastSuccessfulFetchAtMs: 0
  property bool cacheHydrated: false
  property bool settingsReady: false

  // Computed properties for UI
  readonly property bool isReady: connected && cacheHydrated

  // Polling timer
  Timer {
    id: pollTimer
    interval: Math.min(pollInterval * Math.pow(2, Math.min(consecutiveFailures, 3)), maxBackoffMs)
    repeat: true
    running: connected
    onTriggered: fetchStates()
  }

  // Reconnection timer
  Timer {
    id: reconnectTimer
    interval: 5000
    repeat: false
    onTriggered: {
      if (!connected && haUrl && haToken) {
        Logger.d("HAControlCenter", "Attempting reconnection...")
        testConnection()
      }
    }
  }

  // Cache save timer (debounced)
  Timer {
    id: cacheSaveTimer
    interval: 2000
    repeat: false
    onTriggered: flushCachedState()
  }

  property bool cacheDirty: false
  property string lastSavedCacheSnapshot: ""

  // Entity domain helpers
  function getEntityDomain(entityId) {
    if (!entityId) return ""
    const parts = entityId.split(".")
    return parts.length > 0 ? parts[0] : ""
  }

  function getEntityName(entity) {
    if (!entity) return ""
    return entity.attributes?.friendly_name || entity.entity_id || ""
  }

  function getEntityState(entityId) {
    return entityStates[entityId] || null
  }

  function isEntityAvailable(entityId) {
    const entity = entityStates[entityId]
    if (!entity) return false
    return entity.state !== "unavailable" && entity.state !== "unknown"
  }

  // Connection management
  function testConnection() {
    if (!haUrl || !haToken) {
      connected = false
      connecting = false
      connectionError = "No URL or token configured"
      return
    }

    connecting = true
    connectionError = ""

    const xhr = new XMLHttpRequest()
    xhr.onreadystatechange = function () {
      if (xhr.readyState === XMLHttpRequest.DONE) {
        connecting = false
        if (xhr.status === 200) {
          connected = true
          connectionError = ""
          consecutiveFailures = 0
          Logger.d("HAControlCenter", "Connection successful")
          fetchStates()
          fetchAvailableEntities()
        } else if (xhr.status === 401) {
          connected = false
          connectionError = pluginApi?.tr("errors.auth-invalid") || "Invalid access token"
          Logger.e("HAControlCenter", "Authentication failed")
        } else {
          connected = false
          connectionError = "Connection failed: " + xhr.status
          Logger.e("HAControlCenter", "Connection failed:", xhr.status)
          reconnectTimer.start()
        }
      }
    }

    xhr.onerror = function () {
      connecting = false
      connected = false
      connectionError = "Connection error"
      Logger.e("HAControlCenter", "Connection error")
      reconnectTimer.start()
    }

    xhr.open("GET", haUrl + "/api/")
    xhr.setRequestHeader("Authorization", "Bearer " + haToken)
    xhr.timeout = 10000
    xhr.send()
  }

  // HTTP request helper
  function sendHttpRequest(method, endpoint, data, callback) {
    if (!connected) {
      Logger.w("HAControlCenter", "Cannot send request, not connected")
      return -1
    }

    requestId++
    const xhr = new XMLHttpRequest()
    xhr.onreadystatechange = function () {
      if (xhr.readyState === XMLHttpRequest.DONE) {
        let response = null
        try {
          if (xhr.status >= 200 && xhr.status < 300 && xhr.responseText) {
            response = JSON.parse(xhr.responseText)
          }
        } catch (e) {
          Logger.e("HAControlCenter", "Failed to parse JSON:", e)
        }

        if (callback) {
          callback(xhr.status, response)
        }

        if (xhr.status >= 200 && xhr.status < 300) {
          consecutiveFailures = 0
          lastSuccessfulFetchAtMs = Date.now()
        } else {
          consecutiveFailures++
        }
      }
    }

    xhr.onerror = function () {
      Logger.e("HAControlCenter", "HTTP request error for", endpoint)
      consecutiveFailures++
      if (callback) callback(0, null)
    }

    const url = haUrl + endpoint
    xhr.open(method, url)
    xhr.setRequestHeader("Authorization", "Bearer " + haToken)
    xhr.setRequestHeader("Content-Type", "application/json")
    xhr.timeout = 10000

    if (data) {
      xhr.send(JSON.stringify(data))
    } else {
      xhr.send()
    }

    return requestId
  }

  // Fetch all entity states
  function fetchStates() {
    if (!connected || stateFetchInFlight) return

    stateFetchInFlight = true
    sendHttpRequest("GET", "/api/states", null, function (status, response) {
      stateFetchInFlight = false
      if (status === 200 && response && Array.isArray(response)) {
        processStates(response)
        lastSuccessfulFetchAtMs = Date.now()
      } else {
        Logger.w("HAControlCenter", "Failed to fetch states:", status)
      }
    })
  }

  // Fetch available entities (for discovery)
  function fetchAvailableEntities() {
    sendHttpRequest("GET", "/api/states", null, function (status, response) {
      if (status === 200 && response && Array.isArray(response)) {
        const entities = response.map(e => ({
          entity_id: e.entity_id,
          friendly_name: e.attributes?.friendly_name || e.entity_id,
          domain: getEntityDomain(e.entity_id),
          state: e.state
        })).sort((a, b) => a.entity_id.localeCompare(b.entity_id))

        availableEntities = entities
      }
    })
  }

  // Process entity states
  function processStates(states) {
    const newStates = {}
    for (const entity of states) {
      if (entity && entity.entity_id) {
        newStates[entity.entity_id] = entity
      }
    }

    if (JSON.stringify(entityStates) !== JSON.stringify(newStates)) {
      entityStates = newStates
      scheduleCachedStateSave()
    }
  }

  // Service calls by domain
  function callService(domain, service, entityId, serviceData) {
    const data = Object.assign({ entity_id: entityId }, serviceData || {})
    const endpoint = "/api/services/" + domain + "/" + service

    // Optimistic UI update
    optimisticUpdate(entityId, domain, service, serviceData)

    sendHttpRequest("POST", endpoint, data, function (status, response) {
      if (status < 200 || status >= 300) {
        Logger.e("HAControlCenter", "Service call failed:", domain, service, status)
        ToastService.showError(getEntityName(entityStates[entityId]), pluginApi?.tr("errors.service-failed") || "Action failed")
        // Revert optimistic update by fetching fresh state
        fetchStates()
      } else if (response && Array.isArray(response)) {
        // Merge returned states
        for (const entity of response) {
          if (entity && entity.entity_id) {
            entityStates[entity.entity_id] = entity
          }
        }
        scheduleCachedStateSave()
      }
    })
  }

  // Optimistic UI updates
  function optimisticUpdate(entityId, domain, service, serviceData) {
    const entity = entityStates[entityId]
    if (!entity) return

    const newEntity = Object.assign({}, entity)
    newEntity.attributes = Object.assign({}, entity.attributes)

    switch (domain) {
      case "light":
      case "switch":
      case "fan":
      case "automation":
        if (service === "toggle") {
          newEntity.state = entity.state === "on" ? "off" : "on"
        } else if (service === "turn_on") {
          newEntity.state = "on"
        } else if (service === "turn_off") {
          newEntity.state = "off"
        }
        // Handle brightness updates
        if (serviceData?.brightness !== undefined) {
          newEntity.attributes.brightness = serviceData.brightness
        }
        break

      case "climate":
        if (serviceData?.temperature !== undefined) {
          newEntity.attributes.temperature = serviceData.temperature
        }
        if (serviceData?.hvac_mode !== undefined) {
          newEntity.state = serviceData.hvac_mode
        }
        break

      case "cover":
        if (service === "open_cover") {
          newEntity.state = "opening"
        } else if (service === "close_cover") {
          newEntity.state = "closing"
        } else if (service === "stop_cover") {
          newEntity.state = entity.attributes?.current_position > 0 ? "open" : "closed"
        }
        if (serviceData?.position !== undefined) {
          newEntity.attributes.current_position = serviceData.position
        }
        break

      case "button":
      case "input_button":
        // Buttons don't have state changes to optimistically update
        break

      case "scene":
        // Scenes don't toggle - they activate
        break
    }

    const newStates = Object.assign({}, entityStates)
    newStates[entityId] = newEntity
    entityStates = newStates
  }

  // Domain-specific control functions
  function toggleLight(entityId) {
    callService("light", "toggle", entityId)
  }

  function setLightBrightness(entityId, brightness) {
    // brightness is 0-255
    callService("light", "turn_on", entityId, { brightness: Math.round(brightness) })
  }

  function setLightColorTemp(entityId, colorTemp) {
    callService("light", "turn_on", entityId, { color_temp: colorTemp })
  }

  function toggleSwitch(entityId) {
    callService("switch", "toggle", entityId)
  }

  function pressButton(entityId) {
    callService("button", "press", entityId)
  }

  function toggleFan(entityId) {
    callService("fan", "toggle", entityId)
  }

  function setFanSpeed(entityId, speed) {
    const percentage = Math.round(speed * 100)
    callService("fan", "set_percentage", entityId, { percentage: percentage })
  }

  function toggleAutomation(entityId) {
    callService("automation", "toggle", entityId)
  }

  function activateScene(entityId) {
    callService("scene", "turn_on", entityId)
  }

  function setClimateTemperature(entityId, temperature) {
    callService("climate", "set_temperature", entityId, { temperature: temperature })
  }

  function setClimateMode(entityId, mode) {
    callService("climate", "set_hvac_mode", entityId, { hvac_mode: mode })
  }

  function coverOpen(entityId) {
    callService("cover", "open_cover", entityId)
  }

  function coverClose(entityId) {
    callService("cover", "close_cover", entityId)
  }

  function coverStop(entityId) {
    callService("cover", "stop_cover", entityId)
  }

  function setCoverPosition(entityId, position) {
    callService("cover", "set_cover_position", entityId, { position: position })
  }

  // Block configuration
  function getBlocks() {
    return pluginApi?.pluginSettings?.blocks || []
  }

  function addBlock(blockConfig) {
    const blocks = getBlocks()
    const newBlock = Object.assign({
      id: "block_" + Date.now(),
      position: blocks.length
    }, blockConfig)

    const newBlocks = [...blocks, newBlock]
    pluginApi.pluginSettings.blocks = newBlocks
    pluginApi.saveSettings()
    return newBlock.id
  }

  function updateBlock(blockId, updates) {
    const blocks = getBlocks()
    const index = blocks.findIndex(b => b.id === blockId)
    if (index < 0) return false

    const newBlocks = [...blocks]
    newBlocks[index] = Object.assign({}, blocks[index], updates)
    pluginApi.pluginSettings.blocks = newBlocks
    pluginApi.saveSettings()
    return true
  }

  function removeBlock(blockId) {
    const blocks = getBlocks()
    const newBlocks = blocks.filter(b => b.id !== blockId)
    // Reorder positions
    newBlocks.forEach((b, i) => b.position = i)
    pluginApi.pluginSettings.blocks = newBlocks
    pluginApi.saveSettings()
  }

  function reorderBlocks(blockIds) {
    const blocks = getBlocks()
    const blockMap = {}
    blocks.forEach(b => blockMap[b.id] = b)

    const newBlocks = blockIds.map((id, i) => {
      const block = blockMap[id]
      if (block) block.position = i
      return block
    }).filter(b => b)

    pluginApi.pluginSettings.blocks = newBlocks
    pluginApi.saveSettings()
  }

  // Cache management
  function loadCachedStateIfAvailable() {
    if (cacheHydrated) return
    if (!pluginApi || !pluginApi.pluginSettings) return

    settingsReady = true
    const cache = pluginApi.pluginSettings.stateCache
    if (cache && cache.entityStates) {
      entityStates = cache.entityStates
      Logger.d("HAControlCenter", "Loaded cached state")
    }

    lastSavedCacheSnapshot = JSON.stringify(entityStates)
    cacheDirty = false
    cacheHydrated = true
  }

  function scheduleCachedStateSave() {
    if (!settingsReady || !pluginApi) {
      cacheDirty = true
      return
    }

    const snapshot = JSON.stringify(entityStates)
    if (snapshot === lastSavedCacheSnapshot) {
      cacheDirty = false
      return
    }

    cacheDirty = true
    cacheSaveTimer.restart()
  }

  function flushCachedState() {
    if (!settingsReady || !pluginApi) return
    if (!cacheDirty) return

    const snapshot = JSON.stringify(entityStates)
    if (snapshot === lastSavedCacheSnapshot) {
      cacheDirty = false
      return
    }

    if (!pluginApi.pluginSettings) {
      pluginApi.pluginSettings = {}
    }

    pluginApi.pluginSettings.stateCache = {
      entityStates: entityStates,
      timestamp: Date.now()
    }
    pluginApi.saveSettings()

    lastSavedCacheSnapshot = snapshot
    cacheDirty = false
  }

  // Lifecycle
  function refresh() {
    if (connected) {
      fetchStates()
      fetchAvailableEntities()
    } else {
      testConnection()
    }
  }

  function disconnect() {
    flushCachedState()
    connected = false
    connecting = false
    stateFetchInFlight = false
    pollTimer.stop()
  }

  function reconnect() {
    disconnect()
    Qt.callLater(testConnection)
  }

  // Auto-connect
  onHaUrlChanged: {
    if (haUrl && haToken) {
      testConnection()
    } else {
      disconnect()
    }
  }

  onHaTokenChanged: {
    if (haUrl && haToken) {
      testConnection()
    } else {
      disconnect()
    }
  }

  Connections {
    target: pluginApi
    function onPluginSettingsChanged() {
      loadCachedStateIfAvailable()
    }
  }

  Component.onCompleted: {
    loadCachedStateIfAvailable()
    if (haUrl && haToken) {
      testConnection()
    }
  }

  Component.onDestruction: flushCachedState()
}
