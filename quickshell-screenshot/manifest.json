{
  "id": "quickshell-screenshot",
  "name": "Quickshell Screenshot",
  "version": "0.1.1",
  "minNoctaliaVersion": "3.6.0",
  "author": "habibe",
  "license": "MIT",
  "repository": "https://github.com/anthonyhab/noctalia-plugins",
  "description": "Pixel-perfect screenshot tool with draggable region selector for comparing shell instances.",
  "tags": ["Screenshot", "Development", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "allowUserSettings": true,
    "defaultSettings": {
      "outputDir": "",
      "resetTimeoutMinutes": 5,
      "showGrid": true,
      "snapToWindows": true,
      "copyToClipboard": true,
      "openAfterCapture": false,
      "freezeScreen": true,
      "toolbarEdge": "bottom",
      "captureKeybind": "SUPER+SHIFT+ALT+PRINT",
      "selectorKeybind": "SUPER+SHIFT+PRINT"
    }
  }
}
