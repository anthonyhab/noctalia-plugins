{
  "id": "hypr-overview",
  "name": "Hypr Overview",
  "version": "0.1.2",
  "minNoctaliaVersion": "3.6.0",
  "author": "habibe",
  "license": "MIT",
  "repository": "https://github.com/anthonyhab/noctalia-plugins",
  "description": "Visual workspace overview for Hyprland with live previews, drag-and-drop, keyboard navigation, and multi-layout support.",
  "tags": [
    "Hyprland",
    "workspace",
    "overview",
    "productivity"
  ],
  "entryPoints": {
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "main": "Main.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "rows": 2,
      "columns": 5,
      "scale": 0.16,
      "hideEmptyRows": true,
      "showScratchpadWorkspaces": false,
      "gridSpacing": 0,
      "position": "top",
      "barMargin": 0,
      "useSlideAnimation": true,
      "containerBorderWidth": -1,
      "selectionBorderWidth": -1,
      "accentColorType": "secondary",
      "visualMode": "live",
      "shaderPreset": "classic",
      "shaderPresetStrength": 0.7,
      "useSimplifiedPreview": false,
      "showWindowTitleStrip": true,
      "titleStripHeight": 20,
      "titleStripMode": "auto",
      "titleStripPosition": "overlay-top",
      "titleStripMeta": "class",
      "showWindowIcons": true,
      "colorizeWindowIcons": false,
      "windowIconPlacement": "center",
      "showWorkspaceLabels": true,
      "workspaceLabelMode": "number-name",
      "showFocusedWindowGlow": true,
      "showUrgencyBadge": true,
      "showFloatingBadge": true,
      "showFullscreenBadge": false,
      "showMonitorBadge": false,
      "dimInactiveWorkspaces": 0.35,
      "inactiveWorkspaceSaturation": 0.75,
      "hoverLiftAmount": 4,
      "previewCornerMode": "hyprland",
      "previewFixedCornerRadius": 10,
      "useBorderGradient": true,
      "dragPreviewMode": "smart",
      "dragSnapThreshold": 0.33,
      "retilePreviewOpacity": 0.55,
      "previewWindowX": -1,
      "previewWindowY": -1,
      "previewWindowPositions": {},
      "showRowColumnGuides": false,
      "specialWorkspaceStyle": "pill",
      "animationProfile": "hyprlike",
      "animationDurationMs": 200,
      "simplifiedPixelDensity": 0.5,
      "simplifiedColorDepth": 6,
      "simplifiedSaturation": 1.1,
      "simplifiedContrast": 1.1,
      "overviewBackgroundOpacityRatio": 1,
      "showLayoutBadge": true
    }
  }
}
