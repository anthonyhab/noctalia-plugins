{
  "id": "swww-picker",
  "name": "AWWW Wallpaper Picker",
  "version": "0.2.4",
  "minNoctaliaVersion": "3.6.0",
  "author": "habibe",
  "license": "MIT",
  "repository": "https://github.com/anthonyhab/noctalia-plugins",
  "description": "Wallpaper management with awww — optimized for 160Hz VRR displays with snappy bezier transitions.",
  "tags": ["Bar", "Desktop", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "launcherProvider": "LauncherProvider.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "allowUserSettings": true,
    "defaultSettings": {
      "wallpapersDir": "~/Pictures/Wallpapers",
      "autoCycleEnabled": false,
      "autoCycleInterval": 30,
      "transitionType": "fade",
      "transitionDuration": 0.8,
      "transitionFps": 80,
      "transitionStep": 28,
      "transitionBezier": ".4,0,.2,1",
      "shuffleMode": false,
      "showWallpaperName": true,
      "gridColumns": 2
    }
  }
}
